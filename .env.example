# ============================================================
# MatchPoint AI — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get from: supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Anthropic Claude ──────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es

# ── Email Notifications (optional) ───────────────────────────
# Get from: resend.com → API Keys
# Fires when a candidate hits ≥90% match score
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── WhatsApp Alerts (optional) ────────────────────────────────
# Get from: console.twilio.com
# Fires when a candidate hits ≥90% match score
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_PHONE_NUMBER=+34600000000

# ── Admin Portal Guard ────────────────────────────────────────
# Comma-separated list of emails that can access /admin
# ADMIN_EMAILS is server-side (layout guard)
# NEXT_PUBLIC_ADMIN_EMAILS is client-side (Header "Panel Jefe" button)
ADMIN_EMAILS=admin@yourdomain.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com
